generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}
datasource db { provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role { CUSTOMER ADMIN }
enum OrderStatus { PENDING CONFIRMED SHIPPED DELIVERED CANCELLED REFUNDED }

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role Role @default(CUSTOMER)
  emailVerifiedAt DateTime?
  address Json?
  createdAt DateTime @default(now())
  sessions Session[]
  tokens Token[]
  orders Order[]
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}
model Token {
  id String @id @default(cuid())
  tokenHash String @unique
  type String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}
model Product {
  id String @id @default(cuid())
  slug String @unique
  name String
  category String
  description String
  price Int
  compareAt Int?
  images String[]
  isNew Boolean @default(false)
  isBest Boolean @default(false)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  variants Variant[]
}
model Variant {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label String
  stock Int
  priceDelta Int @default(0)
}
model Coupon {
  code String @id
  percent Int @default(0)
  freeShip Boolean @default(false)
  active Boolean @default(true)
}
model Setting {
  key String @id
  value String
}
model Order {
  id String @id @default(cuid())
  number String @unique
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  status OrderStatus @default(PENDING)
  name String
  email String
  phone String
  address String
  city String
  area String
  subtotal Int
  discount Int
  shipping Int
  total Int
  payment String @default("COD")
  coupon String?
  createdAt DateTime @default(now())
  items OrderItem[]
  @@index([createdAt])
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String?
  name String
  label String
  qty Int
  price Int
}

model RateLimit {
  key String @id
  count Int
  resetAt DateTime
}
